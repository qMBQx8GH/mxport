(def element MxSagaMainProgressBarContent (_isFinalActive:bool = false, _isFinalStatsTimeReached:bool = false)
	(scope
		(struct sagaID = EXTRACT_SAGA_ID())

		(var sagaEntity:dhEntity =			"getPrimaryEntity(CC.saga, sagaID.value)")
		(var saga:dhComponent =				"sagaEntity.saga")
		(var areRewardsAvailable:bool =		"saga.rewardsAvailable"		(event "saga.evChanged"))
		(var currentProgress:number =		"saga.currentProgress"		(event "saga.evChanged"))

		(struct journeyRoute =		PULL_ROUTE(_id = "SC.Ui_windows.ROUTE.SAGA_JOURNEY"))
		(var isJourneyRoute:bool =	"journeyRoute.isActive")

		(var sagaCurrentProgressBarElementEntity:dhEntity =	"getSingleEntity(CC.sagaCurrentProgressBarElement)")
		(var sagaCurrentProgressBarElement:dhComponent =	"sagaCurrentProgressBarElementEntity.sagaCurrentProgressBarElement")
		(var untilNextReward:number =						"sagaCurrentProgressBarElement.untilNextReward ?: 0"	(event "sagaCurrentProgressBarElement.evChanged"))
		(var isAllProgressCompleted:bool =					"untilNextReward == 0")

		(var progressBarDescription:str =	"_isFinalStatsTimeReached	? 'IDS_SAGA_FINISHED' :
											 !isAllProgressCompleted	? 'IDS_SAGA_PROGRESSBAR_NEXT_REWARD_IN' :
											 _isFinalActive				? 'IDS_SAGA_PROGRESSBAR_EVENT_FINISHED'
																		: 'IDS_SAGA_PROGRESSBAR_EVENT_ALMOST_FINISHED'")
		(var isNextSagaProgressShown:bool =	"!isAllProgressCompleted && !_isFinalStatsTimeReached")
	)

	(style
		(width = 100%)
		(height = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.HEIGHT")
		(paddingTop = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_VERT")
		(paddingBottom = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_VERT")
		(paddingLeft = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_HOR")
		(paddingRight = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_HOR")
	)

	(block
		(style
			(width = 400px)
			(position = "absolute")
			(right = 0px)
		)

		(tf
			(class $TextDefaultBold20NM)
			(style
				(marginBottom = "SXS")
				(alpha = "TA")
			)

			(text = "toUpper(tr('IDS_SAGA_PROGRESSBAR_TITLE'))")
		)

		(hblock
			(tf
				(class $TextDefaultNM)
				(style
					(marginBottom = "SXS")
					(alpha = "TA")
				)

				(bind text "progressBarDescription")
			)

			(block
				(bind visible "isNextSagaProgressShown")

				(style
					(marginTop = -1px)
					(marginLeft = "S")
				)

				(controller $Instance renderer='PriceTag'
					(bind enabled "isNextSagaProgressShown")
					(args
						_priceInfo =	"{ finalPrice: untilNextReward,	currency: SC.Common.CURRENCIES.SAGA_PROGRESS }"
						_size =			"SIZE.MEDIUM"
					)
				)
			)
		)
	)

	(block
		(style
			(width = 200px)
		)

		(controller $Instance renderer='SagaDefaultButton'
			(bind enabled "isJourneyRoute")
			(args
				_name =			'btn_saga_claim_rewards'
				_enabled =		"areRewardsAvailable"
				_width =		194px
				_label =		'IDS_SAGA_BUTTON_COLLECT_REWARDS'
				_methods =		"[{ type: 'direct.action',	name: 'onClaimSagaRewards',	args: {} }]"
			)
		)
	)

	(element SagaMainProgressBarCarousel
		_isJourneyRoute =		"isJourneyRoute"
		_currentProgress =		"currentProgress"
		_isFinalReached =		"_isFinalActive || _isFinalStatsTimeReached"
	)
)
