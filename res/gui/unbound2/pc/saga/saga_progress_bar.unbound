(def element SagaMainProgressBarContainer (_isFinalActive:bool = false, _isFinalStatsTimeReached:bool = false)
	(style (width = 100%))

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundImage = "SAGA_TEXTURES.SERVICE_KIT.GRADIENTS.BOTTOM")
			(backgroundSize = "fill")
			(alpha = 0.75)
		)
	)

	(block
		(style
			(width = 100%)
			(marginBottom = "SAGA_ELEMS.PROGRESS_BAR.PADDING_BOTTOM")
		)

		(element SagaMainProgressBarContent
			_isFinalActive =			"_isFinalActive"
			_isFinalStatsTimeReached =	"_isFinalStatsTimeReached"
		)
	)
)

(def element SagaMainProgressBarContent (_isFinalActive:bool = false, _isFinalStatsTimeReached:bool = false)
	(scope
		(struct sagaID = EXTRACT_SAGA_ID())

		(var sagaEntity:dhEntity =			"getPrimaryEntity(CC.saga, sagaID.value)")
		(var saga:dhComponent =				"sagaEntity.saga")
		(var areRewardsAvailable:bool =		"saga.rewardsAvailable"		(event "saga.evChanged"))
		(var currentProgress:number =		"saga.currentProgress"		(event "saga.evChanged"))

		(struct journeyRoute =		PULL_ROUTE(_id = "SC.Ui_windows.ROUTE.SAGA_JOURNEY"))
		(var isJourneyRoute:bool =	"journeyRoute.isActive")

		(var sagaCurrentProgressBarElementEntity:dhEntity =	"getSingleEntity(CC.sagaCurrentProgressBarElement)")
		(var sagaCurrentProgressBarElement:dhComponent =	"sagaCurrentProgressBarElementEntity.sagaCurrentProgressBarElement")
		(var untilNextReward:number =						"sagaCurrentProgressBarElement.untilNextReward ?: 0"	(event "sagaCurrentProgressBarElement.evChanged"))
		(var isAllProgressCompleted:bool =					"untilNextReward == 0")

		(var progressBarDescription:str =	"_isFinalStatsTimeReached	? 'IDS_SAGA_FINISHED' :
											 !isAllProgressCompleted	? 'IDS_SAGA_PROGRESSBAR_NEXT_REWARD_IN' :
											 _isFinalActive				? 'IDS_SAGA_PROGRESSBAR_EVENT_FINISHED'
																		: 'IDS_SAGA_PROGRESSBAR_EVENT_ALMOST_FINISHED'")
		(var isNextSagaProgressShown:bool =	"!isAllProgressCompleted && !_isFinalStatsTimeReached")
	)

	(style
		(width = 100%)
		(height = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.HEIGHT")
		(paddingTop = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_VERT")
		(paddingBottom = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_VERT")
		(paddingLeft = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_HOR")
		(paddingRight = "SAGA_ELEMS.PROGRESS_BAR.CONTAINER.PADDING_HOR")
	)

	(block
		(style (width = 400px))

		(tf
			(class $TextDefaultBold20NM)
			(style
				(marginBottom = "SXS")
				(alpha = "TA")
			)

			(text = "toUpper(tr('IDS_SAGA_PROGRESSBAR_TITLE'))")
		)

		(hblock
			(tf
				(class $TextDefaultNM)
				(style
					(marginBottom = "SXS")
					(alpha = "TA")
				)

				(bind text "progressBarDescription")
			)

			(block
				(bind visible "isNextSagaProgressShown")

				(style
					(marginTop = -1px)
					(marginLeft = "S")
				)

				(controller $Instance renderer='PriceTag'
					(bind enabled "isNextSagaProgressShown")
					(args
						_priceInfo =	"{ finalPrice: untilNextReward,	currency: SC.Common.CURRENCIES.SAGA_PROGRESS }"
						_size =			"SIZE.MEDIUM"
					)
				)
			)
		)
	)

	(block
		(style
			(position = "absolute")
			(right = 0px)
		)

		(controller $Instance renderer='SagaDefaultButton'
			(bind enabled "areRewardsAvailable && isJourneyRoute")
			(args
				_name =			'btn_saga_claim_rewards'
				_enabled =		"areRewardsAvailable"
				_width =		194px
				_label =		'IDS_SAGA_BUTTON_COLLECT_REWARDS'
				_methods =		"[{ type: 'direct.action',	name: 'onClaimSagaRewards',	args: {} }]"
			)
		)
	)

	(element SagaMainProgressBarCarousel
		_isJourneyRoute =		"isJourneyRoute"
		_currentProgress =		"currentProgress"
		_isFinalReached =		"_isFinalActive || _isFinalStatsTimeReached"
	)
)

(def element SagaMainProgressBarCarousel (_isJourneyRoute:bool, _currentProgress:number, _isFinalReached:bool = false)
	(scope
		(event evScrollToIndex)

		(var sagaProgress:dhCollection = "getCollection(CC.sagaProgressBarElement)")
		(var sagaScrollToIndex:number = "_currentProgress >= 0	? _currentProgress * 2 >= sagaProgress.length	? (_currentProgress * 2) - 1
																												: _currentProgress * 2
																: 0")
	)

	(dispatch evScrollToIndex	args="{ value: sagaScrollToIndex }"	delay=0.2	on='addedToStage')

	(style
		(flow = "horizontal")
		(width = 100%)
		(height = "SAGA_ELEMS.PROGRESS_BAR.PROGRESS_LINE.HEIGHT")
	)

	(scrollArea
		(class $Fullsize)
		(style (backgroundColor = "NO_COLOR"))

		(macro DEFAULT_HORIZONTAL_SCROLL_PARAMS
			_singleStep =				"SAGA_ELEMS.PROGRESS_BAR.ITEM.WIDTH"
			_wheelScrollSpeed =			"0.7"
			_wheelScrollAcceleration =	"0.8"
			_valueChangedEvent =		"'evCarouselScrollValueChanged'"
			_hasShadow =				"true"
		)

		(repeatController = 'SagaMainProgressBarCarousel')
		(scrollPerItem = true)

		(content
			(style
				(flow = "horizontal")
				(width = 100%)
				(height = "SAGA_ELEMS.PROGRESS_BAR.ITEM.HEIGHT")
			)

			(controller $DynamicRepeat renderer='SagaRewardsCarouselItem' name='SagaMainProgressBarCarousel'
				(bind count "sagaProgress.length")
				(args
					_sagaProgressEntity =	"sagaProgress.getEntityAtIndex($index)"
					_isJourneyRoute =		"_isJourneyRoute"
					_isFinalReached =		"_isFinalReached"
				)
				(bind itemWidth "SAGA_ELEMS.PROGRESS_BAR.ITEM.WIDTH")
				(bind itemOffset "SAGA_ELEMS.PROGRESS_BAR.ITEM.WIDTH * 2")
			)
		)

		(bindcall scrollTo		index="$event.value" watch=false (event "evScrollToIndex"))
	)

	(element FinalSagaMainProgressBarRewardContainer
		_isJourneyRoute =	"_isJourneyRoute"
		_isFinalReached =	"_isFinalReached"
	)
)

(def element FinalSagaMainProgressBarRewardContainer (_isJourneyRoute:bool, _isFinalReached:bool)
	(scope
		(event evShowIconCheck)

		(struct mouseHandler = MOUSE_HANDLER())

		(var sagaFinalRewardsEntity:dhEntity =	"getSingleEntity(CC.sagaFinalRewardsElement)")
		(var sagaFinalRewards:dhComponent =		"sagaFinalRewardsEntity.sagaFinalRewardsElement")

		(var isClaimed:bool =	"sagaFinalRewards.isClaimed"	(event "sagaFinalRewards.evChanged"))
		(var rewards:array =	"sagaFinalRewards.rewards"		(event "sagaFinalRewards.evChanged"))

		(var mainRewardId:number =			"rewards[0]")
		(var mainRewardEntity:dhEntity =	"getEntity(mainRewardId)")
		(var mainReward:dhComponent =		"mainRewardEntity.rewardComponent")

		(var reward:dict =	"{	id:			mainReward.id,
								amount:		mainReward.amount,
								name:		mainReward.name,
								type:		mainReward.type,
								subtype:	mainReward.subtype,
								params:		mainReward.params,
								isPRMP:		mainReward.isPRMP }")

		(var isClickable:bool =		"!isClaimed && _isJourneyRoute && !_isFinalReached")
	)

	(dispatch evShowIconCheck		dir="EventDirection.NONE"	(bind enabled "isClaimed") (bind trigger "isClaimed"))

	(style
		(align = "center|middle")
		(width = "SAGA_ELEMS.PROGRESS_BAR.ITEM.WIDTH")
		(height = "SAGA_ELEMS.PROGRESS_BAR.ITEM.HEIGHT")
		(backgroundColor = "NO_COLOR")
	)

	(element RewardItem
		_reward =						"reward"
		_isBattlePassSmallIconView =	true
		_isUnavailable =				"isClaimed"
		_isCheckIconForceHidden =		true
		_withTooltip =					false
	)

	(controller $Tooltip
		(renderer = 'FinalSagaRewardTooltip')
		(args
			_rewards = "rewards"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)

	(block
		(bind visible "isClaimed")

		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(align = "center|middle")
		)

		(block
			(style
				(width = 48px)
				(height = 48px)
				(pivotX = 50%)
				(pivotY = 50%)
				(backgroundImage = 'url:../reward_categories/icon_check.png')
			)

			(controller $Animation
				(bindcall play
					duration =	0.5
					from =		"{ visualScaleX: 2, visualScaleY: 2, alpha: 0 }"
					to =		"{ visualScaleX: 1, visualScaleY: 1, alpha: 1 }"
					(event "evShowIconCheck")
				)
			)
		)
	)

	(macro DEFAULT_CONTROL_STATE_ANIMATION_CT " isClickable && mouseHandler.mouseDown	? COLOR_TRANSFORM_MOUSE_DOWN :
												isClickable && mouseHandler.rollOver	? COLOR_TRANSFORM_MOUSE_OVER
																						: CT_NONE")

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_mouseHandler =	"mouseHandler"
		_soundSet =		"isClickable ? 'button_battlepass_reward' : ''"
	)
	(macro STRUCT_DISPATCH_HANDLER
		_enabled =			"isClickable"
		_mouseHandler =		"mouseHandler"
		_dispatchedEv =		"'evUpdateViewedReward'"
		_dispatchParams =	"{ value: mainRewardId }"
	)
)

(def element SagaRewardsCarouselItem (_sagaProgressEntity:dhEntity, _isJourneyRoute:bool = false, _isFinalReached:bool = false)
	(scope
		(var sagaProgressBarElement:dhComponent = "_sagaProgressEntity.sagaProgressBarElement")
		(var type:number =			"sagaProgressBarElement.type"		(event "sagaProgressBarElement.evChanged"))

		(var isProgressBar:bool =	"type == SC.Sagas.REWARDS_PROGRESS_BAR_ELEMENTS.PROGRESS")
	)

	(style
		(align = "center|middle")
		(width = "SAGA_ELEMS.PROGRESS_BAR.ITEM.WIDTH")
		(height = "SAGA_ELEMS.PROGRESS_BAR.ITEM.HEIGHT")
		(bind paddingLeft "isProgressBar ? 1px : 0px")
		(bind paddingRight "isProgressBar ? 1px : 0px")
	)

	(controller $Instance renderer='SagaRewardItemAdapter'
		(bind enabled "!isProgressBar")
		(args
			_progressBarRewardEntity =	"_sagaProgressEntity"
			_isJourneyRoute =			"_isJourneyRoute"
			_isFinalReached =			"_isFinalReached"
		)
	)

	(controller $Instance renderer='SagaMainProgressBarProgressElem'
		(bind enabled "isProgressBar")
		(args
			_progressBarRewardEntity = "_sagaProgressEntity"
		)
	)
)

(def element SagaRewardItemAdapter (_progressBarRewardEntity:dhEntity, _isJourneyRoute:bool = true, _isFinalReached:bool = false)
	(scope
		(event evShowIconCheck)

		(struct mouseHandler = MOUSE_HANDLER())

		(var sagaProgressBarElement:dhComponent = "_progressBarRewardEntity.sagaProgressBarElement")
		(var rewardID:number =			"sagaProgressBarElement.rewardID"	(event "sagaProgressBarElement.evChanged"))
		(var isClaimed:bool =			"sagaProgressBarElement.isClaimed"	(event "sagaProgressBarElement.evChanged"))
		(var currentProgress:number =	"sagaProgressBarElement.currentProgress ?: 0"	(event "sagaProgressBarElement.evChanged"))

		(var isObtainable:bool =	"!isClaimed && floor(currentProgress) == 1")
		(var isClickable:bool =		"!isClaimed && _isJourneyRoute && !_isFinalReached")

		(var rewardEntity:dhEntity = "getEntity(rewardID)")
		(var reward:dict = "{	id:			rewardEntity.rewardComponent.id,
								amount:		rewardEntity.rewardComponent.amount,
								name:		rewardEntity.rewardComponent.name,
								type:		rewardEntity.rewardComponent.type,
								subtype:	rewardEntity.rewardComponent.subtype,
								params:		rewardEntity.rewardComponent.params,
								isPRMP:		rewardEntity.rewardComponent.isPRMP }")
	)

	(dispatch evShowIconCheck		dir="EventDirection.NONE"	(bind enabled "isClaimed") (bind trigger "isClaimed"))

	(block
		(bind visible "isObtainable")

		(class $MiddleVHAbsolutely)
		(style
			(hitTest = false)
			(ubScaleX = 0.6)
			(ubScaleY = 0.6)
			(width = 250px)
			(height = 250px)
			(backgroundSize = "cover")
			(bind backgroundImage "isObtainable ? 'url:../animations/spine/rewards/reward_states/available.skel' : ''")
		)
		(colorTransform = "SAGA_COLORS.COLOR_TRANSFORM.REWARD.GLOW.TEAL")

		(controller $Spine)
	)

	(element RewardItem
		_reward =						"reward"
		_isBattlePassSmallIconView =	true
		_isUnavailable =				"isClaimed"
		_isCheckIconForceHidden =		true
		_withTooltip =					true
	)

	(macro DEFAULT_CONTROL_STATE_ANIMATION_CT " isClickable && mouseHandler.mouseDown	? COLOR_TRANSFORM_MOUSE_DOWN :
												isClickable && mouseHandler.rollOver	? COLOR_TRANSFORM_MOUSE_OVER
																						: CT_NONE")

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)
	(macro STRUCT_SOUND_HANDLER
		_mouseHandler =	"mouseHandler"
		_soundSet =		"isClickable ? 'button_battlepass_reward' : ''"
	)
	(macro STRUCT_DISPATCH_HANDLER
		_enabled =			"isClickable"
		_mouseHandler =		"mouseHandler"
		_dispatchedEv =		"'evUpdateViewedReward'"
		_dispatchParams =	"{ value: rewardEntity.id }"
	)

	(block
		(bind visible "isClaimed")

		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(align = "center|middle")
		)

		(block
			(style
				(width = 48px)
				(height = 48px)
				(pivotX = 50%)
				(pivotY = 50%)
				(backgroundImage = 'url:../reward_categories/icon_check.png')
			)

			(controller $Animation
				(bindcall play
					duration =	0.5
					from =		"{ visualScaleX: 2, visualScaleY: 2, alpha: 0 }"
					to =		"{ visualScaleX: 1, visualScaleY: 1, alpha: 1 }"
					(event "evShowIconCheck")
				)
			)
		)
	)
)

(def element SagaMainProgressBarProgressElem (_progressBarRewardEntity:dhEntity)
	(scope
		(event evShowHighlightedProgress)
		(event evHideHighlightedProgress)

		(var sagaProgressBarElement:dhComponent =	"_progressBarRewardEntity.sagaProgressBarElement")
		(var currentProgress:number =				"sagaProgressBarElement.currentProgress ?: 0"		(event "sagaProgressBarElement.evChanged"))
		(var highlightedProgress:number =			"sagaProgressBarElement.highlightedProgress ?: 0"	(event "sagaProgressBarElement.evChanged"))

		(var visualCurrentProgress:number =			"ceil(currentProgress * 100)")
		(var visualHighLightedProgress:number =		"ceil(highlightedProgress * 100)")
	)

	(dispatch evShowHighlightedProgress		dir="EventDirection.NONE"	(bind enabled "highlightedProgress != 0") (bind trigger "highlightedProgress"))
	(dispatch evHideHighlightedProgress		dir="EventDirection.NONE"	 (bind enabled "highlightedProgress == 0") (bind trigger "highlightedProgress"))

	(style
		(flow = "horizontal")
		(width = 100%)
		(height = 16px)
		(backgroundColor = 0x40ffffff)
		(borderRadius = "XXS")
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundColor = "NO_COLOR")
			(borderRadius = "XXS")
		)
		(isMask = true)
	)

	(block
		(style
			(bind width "toPercent(visualCurrentProgress)")
			(height = 100%)
			(backgroundColor = "SAGA_COLORS.TEAL")
			(alpha = 0.8)
		)
	)

	(block
		(visible = false)

		(style
			(bind width "toPercent(visualHighLightedProgress)")
			(height = 100%)
			(backgroundColor = "SAGA_COLORS.TEAL")
			(alpha = 0)
		)

		(controller $Animation
			(controllerEvents	evStartHighlightLoop)

			(bindcall play
				to =			"{ alpha: 0.4,	visible: true }"
				duration =		0.2
				action =		"kill"
				easing =		"Easing.quart_out"
				onEndedEvent =	'evStartHighlightLoop'
				(event "evShowHighlightedProgress")
			)
			(bindcall play
				to =			"{ alpha: 0,	visible: false }"
				duration =		0.5
				action =		"kill"
				easing =		"Easing.quart_out"
				(event "evHideHighlightedProgress")
			)

			(bindcall play
				keyframes = "[
					{ percent: 0,		to: { alpha: 0.4 }},
					{ percent: 50,		to: { alpha: 0.7 }},
					{ percent: 100,		to: { alpha: 0.4 }}
				]"
				duration =		1
				repeatCount =	-1
				action =		"kill"
				on =			'evStartHighlightLoop'
			)
		)
	)
)

(def element FinalSagaRewardTooltip (_rewards:array)
	(scope
		(var mainRewardId:number =				"_rewards[0]")
		(var additionalRewardId:number =		"_rewards[1]")
		(var mainRewardEntity:dhEntity =		"getEntity(mainRewardId)")
		(var additionalRewardEntity:dhEntity =	"getEntity(additionalRewardId)")
		(var mainReward:dhComponent =			"mainRewardEntity.rewardComponent")
		(var additionalReward:dhComponent =		"additionalRewardEntity.rewardComponent")

		(var reward1:dict =	"{	id:			mainReward.id,
								amount:		mainReward.amount,
								name:		mainReward.name,
								type:		mainReward.type,
								subtype:	mainReward.subtype,
								params:		mainReward.params,
								isPRMP:		mainReward.isPRMP }")
		(var reward2:dict =	"{	id:			additionalReward.id,
								amount:		additionalReward.amount,
								name:		additionalReward.name,
								type:		additionalReward.type,
								subtype:	additionalReward.subtype,
								params:		additionalReward.params,
								isPRMP:		additionalReward.isPRMP }")

		(var rewardsToDisplay:array =	"[reward1, reward2]")
	)

	(style (width = "DEFAULT_TOOLTIP_WIDTH"))
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_SAGA_PROGRESSBAR_FINAL_REWARD_TOOLTIP_HEADER'
		)

		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemRewards
			_rewards = "rewardsToDisplay"
		)
	)
)
