(def constant BP_LEVEL_SIZE_MIN 120)
(def constant BP_LEVEL_SIZE_MAX 150)
(def constant BP_REWARD_ANIMATION_HEIGHT_MIN 720)
(def constant BP_REWARD_ANIMATION_HEIGHT_MAX 900)
(def constant BP_FREE_REWARD_ANIMATION_WIDTH_MIN 840)
(def constant BP_FREE_REWARD_ANIMATION_WIDTH_MAX 1050)
(def constant BP_PAID_REWARD_ANIMATION_WIDTH_MIN 1536)
(def constant BP_PAID_REWARD_ANIMATION_WIDTH_MAX 1920)
(def constant REWARD_PROGRESS_ANIMATION_TIME 3)
(def constant BP_PROGRESSBAR_HEIGHT 8)
(def constant BP_PROGRESSBAR_NUMBERS_OFFSET 28)
(def constant BP_WINDOW_HORIZONTAL_MARGINS "{1280:16, 1920:32}")
(def constant BP_WINDOW_VERTICAL_MARGINS "{720:40, 1080:80}")
(def constant BP_LEVELS_TO_SHOW_BEFORE_CURRENT_LEVEL 4)
(def constant BP_SPINE_PATH 'url:../animations/spine/battlepass/')

(def constant CT_FREE_REWARD_AVAILABLE "{
	redMultiplier: 0.2,
	greenMultiplier: 0.95,
	blueMultiplier: 1.05,
	alphaMultiplier: 0.9,
	redOffset: 60,
	greenOffset: 60,
	blueOffset: 60,
	alphaOffset: 0
}")

(def constant CT_PAID_REWARD_AVAILABLE "{
	redMultiplier: 1.3,
	greenMultiplier: 0.7,
	blueMultiplier: 0.2,
	alphaMultiplier: 0.9,
	redOffset: 60,
	greenOffset: 60,
	blueOffset: 60,
	alphaOffset: 0
}")

(def constant BP_CHOICE_BUTTON_WARNING "{
	NONE: 0,
	LOCKED_BY_TYPE_AND_LEVEL: 1,
	LOCKED_BY_LEVEL: 2,
	LOCKED_BY_BONUSES: 3
}")

(def constant CELL_ALPHA "{
	SC.Ui_styles.BUTTON_STATE.DISABLED	: 0.02,
	SC.Ui_styles.BUTTON_STATE.SELECTED	: 0.1,
	SC.Ui_styles.BUTTON_STATE.DOWN		: 0.02,
	SC.Ui_styles.BUTTON_STATE.OVER		: 0.1,
	SC.Ui_styles.BUTTON_STATE.UP		: 0.05
}")

(def css $BPCarouselVertBorder ()
	(position = "absolute")
	(width = 1px)
	(height = 100%)
	(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
	(alpha = 0.1)
)

(def css $BPCarouselVertLeftBorder ()
	(extends $BPCarouselVertBorder)
	(left = 0)
)

(def css $BPCarouselVertRightBorder ()
	(extends $BPCarouselVertBorder)
	(right = 0)
)


(def element ModalWindowBattlePassMain ()
	(macro MODAL_WINDOW_INIT)
	(scope
		(event evCarouselScrollValueChanged)
		(event evCarouselBoundsChanged)
		(event evTakeRewardsButtonClicked)
		(event evTakeRewardClicked)
		(event evForceScrollToIndex)
		(event evOpenModal)

		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageWidth"))
		(var battlePassResearchEntity:dhEntity = "getPrimaryEntity(CC.splitRunTest, 'BattlePass_Research')")
		(var isEndSeasonOfferDeactivated:bool = "battlePassResearchEntity.splitRunTest.data.isEndSeasonOfferDeactivated" (event "battlePassResearchEntity.splitRunTest.evDataChanged"))

		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())

		(var battlePassEntity:dhEntity = "getSingleEntity(CC.battlePass)")
		(var battlePassComponent:dhComponent = "battlePassEntity.battlePass")
		(var isOnboardingNeeded:bool =				"battlePassComponent.isOnboardingNeeded"				(event "battlePassComponent.evChanged"))
		(var isEndSeasonOfferAvailable:bool =		"battlePassComponent.isEndSeasonOfferAvailable"			(event "battlePassComponent.evEndSeasonOfferAvailable"))
		(var isStartSeasonReminderAvailable:bool =	"battlePassComponent.isStartSeasonReminderAvailable"	(event "battlePassComponent.evStartSeasonReminderAvailable"))
		(var isEndSeasonReminderAvailable:bool =	"battlePassComponent.isEndSeasonReminderAvailable"		(event "battlePassComponent.evEndSeasonReminderAvailable"))
		(var bpId:number =							"battlePassComponent.id"								(event "battlePassComponent.evChanged"))
		(var observableReward:number =				"battlePassComponent.observableReward"					(event "battlePassComponent.evObservableRewardChanged"))
		(var claimRewardsStackId:number =			"battlePassComponent.previewRewardsStack"				(event "battlePassComponent.evChanged"))
		(var hasMultiRewards:bool =					"battlePassComponent.hasMultiRewards"					(event "battlePassComponent.evChanged"))
		(var hasUnclaimedMultipleRewards:bool =		"battlePassComponent.hasUnclaimedMultiRewards"			(event "battlePassComponent.evChanged"))

		(struct bpType = PULL_BATTLEPASS_TYPE (_component = "battlePassComponent"))

		(var postProgressionEntity:dhEntity = "getSingleEntity(CC.battlePassPostProgressionLevel)")
		(var isPostProgression:bool = "postProgressionEntity.battlePassLevel.isUnlocked" (event "postProgressionEntity.battlePassLevel.evChanged"))

		(var collectionLevels:dhCollection = "getCollection(CC.battlePassLevel)")
		(var isLastLevel:bool = "battlePassCurrentLevel.level == collectionLevels.length")

		(var collectionRewards:dhCollection = "getCollectionByPath(CC.battlePassReward, 'unclaimedRewards')")
		(var hasReward:bool = "collectionRewards.length > 0")

		(var isClaimRequestEnabled:bool = "hasUnclaimedMultipleRewards && !bpType.isPaidEnhanced")

		(var bpTitle:str = "bpType.isFree			? 'IDS_BATTLEPASS_TYPE_FREE' :
							bpType.isPaidEnhanced	? 'IDS_BATTLEPASS_TYPE_PAID_ENHANCED'
													: 'IDS_BATTLEPASS_TYPE_PAID_REGULAR'")

		(var scrollPosition:number = 0)
		(var carouselWidth:number = 0)
		(bind scrollPosition "$event.newValue" init=false (event "evCarouselScrollValueChanged"))
		(bind carouselWidth "$event.bounds[2]" init=false (event "evCarouselBoundsChanged"))

		(var isBoostButtonVisible:bool = "!bpType.isFree && !isPostProgression && !isLastLevel")

		(var isLargeDimension:bool = "stageWidth > 1760 && stageHeight > 900")
		(var btnWidth:number = "isLargeDimension ? 220px : 180px")
		(var btnSize:number = "isLargeDimension ? SIZE.LARGE : SIZE.MEDIUM")
		(var btnText:str = "bpType.isFree			? 'IDS_BATTLEPASS_STATUS_BUTTON_IMPROVEMENT' :
							bpType.isPaidEnhanced	? 'IDS_BATTLEPASS_PURCHASE_TITLE'
													: 'IDS_BATTLEPASS_PURCHASE_BUTTON_BONUSES'")
		(var btnName:str = "bpType.isFree			? 'btn_battlepass_improvements' :
							bpType.isPaidEnhanced	? 'btn_battlepass_improvements_and_bonuses'
													: 'btn_battlepass_purchase_bonuses'")

		(var screenBg:str = "bpType.isFree ? 'url:../sse/battlepass/bg/screen_free.png' : 'url:../sse/battlepass/bg/screen_paid.png'")
		(var bpInfoPosition:number = "LS + levelDimensions.height + BP_PROGRESSBAR_NUMBERS_OFFSET + L")

		(var isShowProgressAnimation:bool = false)
		(bind isShowProgressAnimation "true" init=false (event "evTakeRewardsButtonClicked"))
		(bind isShowProgressAnimation "false" init=false (event "evOpenModal"))
	)
	(name = 'window_ModalWindowBattlePassMain')
	(bindcall externalCall
		"isStartSeasonReminderAvailable && !hasMultiRewards ? 'inputMapping.onAction' : ''"
		"['BattlePassProxyUSS.setBattlePassFlag', {battlePassFlag: SC.Common.BATTLEPASS_SEASON_FLAGS.START_SEASON_REMINDER_SHOWN}]"
		on='addedToStage'
	)
	(bindcall externalCall
		"isEndSeasonReminderAvailable ? 'inputMapping.onAction' : ''"
		"['BattlePassProxyUSS.setBattlePassFlag', {battlePassFlag: SC.Common.BATTLEPASS_SEASON_FLAGS.END_SEASON_REMINDER_SHOWN}]"
		on='addedToStage'
	)
	(bindcall externalCall
		"isOnboardingNeeded ? 'inputMapping.onRequest' : ''"
		"['showBattlePassOnboarding', { }]"
		on='addedToStage'
	)
	(bindcall externalCall
		"!isEndSeasonOfferDeactivated && isEndSeasonOfferAvailable ? 'inputMapping.onRequest' : ''"
		"['showBattlePassFastRewardsSale', { }]"
		on='addedToStage'
	)
	(bindcall externalCall
		"'inputMapping.onRequest'"
		"['openRewardsModalWithoutAnimation', {	rewardsEntityId: claimRewardsStackId, header: 'IDS_RECEIVED_LOOTBOXES_REWARDS' }]"
		watch=false
		(event "battlePassComponent.evShowRewards")
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.5)
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "fill")
			(bind backgroundImage "screenBg")
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 4.5)
		(class $FullsizeAbsolute)
		(style (paddingBottom = "LS"))
		(element BattlePassCarousel)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1)
		(style (width = 100%))

		(element ModalWindowHeaderFullSize
			_backButtonText = 'IDS_RETURN_FROM_MODAL_WINDOW_BUTTON'
			_hideDivider = true
			_paddingTop = "M"
			_paddingRight = "M"
			_paddingLeft = "M"
			_closeIconName = 'battlePassMainScreenEsc'
			_methods = "[
				{
					type: 'inputMapping.onRequest',
					name: 'goToPort',
					args: {}
				}
			]"
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 1.5)
		(style
			(position = "absolute")
			(left = "BP_WINDOW_HORIZONTAL_MARGINS")
			(top = "BP_WINDOW_VERTICAL_MARGINS")
		)

		(tf
			(class $TextDefaultBold36NM)
			(style
				(marginBottom = "SXS")
				(alpha = "TA")
			)
			(bind text "toUpper(tr(bpTitle))")
		)

		(block
			(name = 'battlepass_timer')
			(style (marginBottom = "{720:L, 1080:LM}"))
			(element BattlePassTimer)
		)

		(block
			(style (marginBottom = "M"))
			(element BattlePassStatus
				_isBattlePassFree = "bpType.isFree"
			)
		)

		(hblock
			(style (gap = "M"))

			(element DefaultButton
				_name = 'btn_battlepass_sse_tasks'
				_width = 180
				_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
				_focusIndex = 4
				_label = 'IDS_BATTLEPASS_TASKS_BUTTON'
				_methods = "[
					{
						type: 'inputMapping.onRequest',
						name: 'showBattlePassTasks',
						args: {}
					}
				]"
			)

			(element DefaultButton
				_name = 'show_battlepass_onboarding'
				_width = 180
				_size = "SIZE.MEDIUM"
				_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
				_focusIndex = 2
				_isTransactionBtn = true
				_label = 'IDS_BATTLEPASS_INFO_TEXT_0'
				_methods = "[
					{
						type: 'inputMapping.onRequest',
						name: 'showBattlePassOnboarding',
						args: { }
					}
				]"
			)
		)
	)

	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 2.5)

		(style
			(position = "absolute")
			(right = "BP_WINDOW_HORIZONTAL_MARGINS")
			(bind top "bpType.isPaidEnhanced ? {720:20px, 1080:60px} : BP_WINDOW_VERTICAL_MARGINS")
		)

		(element BattlePassUpgradeButton
			_btnSize = "btnSize"
			_btnText = "btnText"
			_btnName = "btnName"
			_isBattlePassPaidEnhanced = "bpType.isPaidEnhanced"
		)
	)

	
	(hblock
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 3.5)
		(style
			(position = "absolute")
			(gap = "S")
			(right = "BP_WINDOW_HORIZONTAL_MARGINS")
			(bind bottom "bpInfoPosition")
		)

		(block
			(style (bind marginRight "isBoostButtonVisible ? MS : 0"))

			(controller $Instance renderer='DefaultButton'
				(bind enabled "isBoostButtonVisible")
				(args
					_name = 'speed_up_progress'
					_width = "btnWidth"
					_size = "btnSize"
					_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
					_enabled = "!isShowProgressAnimation"
					_isTransactionBtn = true
					_focusIndex = 3
					_label = 'IDS_BATTLEPASS_STATUS_BUTTON_BOOST'
					_methods = "[
						{
							type: 'inputMapping.onAction',
							name: 'BattlePassProxyUSS.previewBattlePassLevels',
							args: { levelsToPreview: 1 }
						},
						{
							type: 'inputMapping.onRequest',
							name: 'purchaseBattlePassLevels',
							args: {}
						}
					]"
				)
			)
		)

		(block
			(dispatch evForceScrollToIndex dir="EventDirection.DOWN" (event "evTakeRewardsButtonClicked"))
			(dispatch evTakeRewardClicked dir="EventDirection.DOWN" delay=0.5 (event "evForceScrollToIndex") (event "battlePassComponent.evStartRewardClaimAnimation"))
			(dispatch evOpenModal delay="REWARD_PROGRESS_ANIMATION_TIME" (event "evTakeRewardClicked"))
			(bindcall externalCall
				"'inputMapping.onRequest'"
				"['openRewardsModalWithoutAnimation', {	rewardsEntityId: claimRewardsStackId, header: 'IDS_RECEIVED_LOOTBOXES_REWARDS' }]"
				watch=false
				(event "evOpenModal")
			)
			(element DefaultButton
				_focusIndex = 0
				_name = 'battlepass_main_mw_take_rewards'
				_defaultFocused = true
				_isTransactionBtn = true
				_width = "btnWidth"
				_size = "btnSize"
				_enabled = "hasReward"
				_label = 'IDS_BATTLEPASS_STATUS_BUTTON_CLAIM_REWARDS'
				_dispatchedEv = "isClaimRequestEnabled ? '' : 'evTakeRewardsButtonClicked'"
				_methods = "[
					{
						type: isClaimRequestEnabled ? 'inputMapping.onRequest' : '',
						name: 'rewardsClaimConfirm',
						args: { }
					},
					{
						type: isClaimRequestEnabled ? '' : 'inputMapping.onAction',
						name: 'BattlePassProxyUSS.claimAllRewards',
						args: { battlePassId: bpId }
					}
				]"
			)

			(controller $Tooltip
				(bind enabled "isLastLevel && !hasReward")
				(renderer = 'SimpleStatusTooltip')
				(args
					_text = 'IDS_BATTLEPASS_STATUS_BUTTON_REWARDS_TOOLTIP'
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)
	)

	
	(block
		(macro DEFAULT_MODAL_WINDOW_ANIMATION 3)
		(style
			(position = "absolute")
			(left = "BP_WINDOW_HORIZONTAL_MARGINS")
			(bind bottom "bpInfoPosition")
		)
		(element BattlePassRewardInfo
			_battlePassRewardEntityId = "observableReward"
		)
	)
)

(def element BattlePassUpgradeButton (	_btnSize:number,
										_btnText:str,
										_btnName:str,
										_isBattlePassPaidEnhanced:bool)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())
	)
	(style
		(align = "middle")
		(flow = "horizontal")
	)

	(block
		(bind visible "!_isBattlePassPaidEnhanced")
		(style
			(hitTest = false)
			(position = "absolute")
			(top = -80px)
			(left = -80px)
			(width = 250px)
			(height = 250px)
			(backgroundSize = "cover")
			(bind backgroundImage "_isBattlePassPaidEnhanced	? ''
																: 'url:../animations/spine/rewards/reward_states/available.skel'")
		)
		(controller $Spine)
	)

	(block
		(bind visible "!_isBattlePassPaidEnhanced")
		(style
			(hitTest = false)
			(width = 80px)
			(height = 80px)
			(marginRight = -20px)
			(backgroundImage = 'url:../sse/battlepass/types/small/paid_enhanced.png')
			(backgroundSize = "cover")
			(zindex = 1)
		)
	)

	(block
		(style (zindex = 0))
		(block
			(class $FullsizeAbsolute)
			(style
				(hitTest = false)
				(backgroundSize = "cover")
				(bind backgroundImage "_isBattlePassPaidEnhanced	? ''
																	: BP_SPINE_PATH + 'button_purchase/glow.skel'")
			)
			(controller $Spine)
		)

		(element DefaultButton
			_name = "_btnName"
			_label = "_btnText"
			_width = "_btnSize == SIZE.LARGE ? 220px : 180px"
			_size = "_btnSize"
			_focusIndex = 1
			_type = "SC.Ui_styles.BUTTON_TYPE.SECONDARY"
			_isTransactionBtn = true
			_externalRollover = "mouseHandler.rollOver"
			_externalMouseDown = "mouseHandler.mouseDown"
		)
	)

	(block
		(class $FullsizeAbsolute)
		(element MOUSE_HANDLER_CONTAINER
			(macro STRUCT_MOUSE_DISPATCHER
				_mouseHandler = "mouseHandler"
			)

			(macro STRUCT_SOUND_HANDLER
				_mouseHandler = "mouseHandler"
				_soundSet = "'button_secondary'"
			)

			(macro STRUCT_CLICK_HANDLER
				_mouseHandler = "mouseHandler"
				_methods = "[
					{
						type: 'inputMapping.onRequest',
						name: 'purchaseBattlePass',
						args: {}
					}
				]"
			)
		)
	)
)

(def element BattlePassCarousel ()
	(scope
		(event evCarouselScrollValueChanged)
		(event evCarouselBoundsChanged)

		(struct stageSize = STAGE_SIZE())
		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageSize.width"))

		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var bpType:number = "battlePassComponent.type" (event "battlePassComponent.evChanged"))
		(var observableSpecialLevel:number = "battlePassComponent.observableSpecialLevel ?: 0" (event "battlePassComponent.evObservableSpecialLevelChanged"))
		(var isBattlePassFree:bool = "bpType == SC.Common.BATTLEPASS_TYPES.FREE")

		(var scrollPosition:number = 0)
		(var carouselWidth:number = 0)
		(bind scrollPosition "$event.newValue" init=false (event "evCarouselScrollValueChanged"))
		(bind carouselWidth "$event.bounds[2]" init=false (event "evCarouselBoundsChanged"))
	)
	(class $Fullsize)
	(style
		(flow = "horizontal")
		(align = "bottom")
	)

	(block
		(style
			(position = "absolute")
			(bottom = 0px)
			(width = 100%)
			(scale9grid = 2)
			(bind height "levelDimensions.size")
			(bind backgroundImage "isBattlePassFree	? 'url:../sse/battlepass/bg/carousel_free.png'
													: 'url:../sse/battlepass/bg/carousel_paid.png'")
		)
	)

	(block
		(style
			(position = "absolute")
			(bottom = 0px)
			(width = 55px)
			(scale9grid = 4)
			(backgroundImage = 'url:../sse/battlepass/carousel_shadow_left.png')
			(bind left "levelDimensions.size")
			(bind height "levelDimensions.height")
		)
	)

	(block
		(style
			(position = "absolute")
			(bottom = 0px)
			(width = 55px)
			(scale9grid = 4)
			(backgroundImage = 'url:../sse/battlepass/carousel_shadow_right.png')
			(bind right "levelDimensions.size")
			(bind height "levelDimensions.height")
		)
	)

	(element BattlePassTypes
		_type = "bpType"
	)

	(element BattlePassProgressWithRewards)

	(element BattlePassLevelFixed
		_entityId = "observableSpecialLevel"
		_isBattlePassFree = "isBattlePassFree"
		_carouselWidth = "carouselWidth"
		_scrollPosition = "scrollPosition"
	)
)

(def element BattlePassStatus (_isBattlePassFree:bool = true)
	(scope
		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())

		(var previousLevelEntity:dhEntity = "getEntity(battlePassCurrentLevel.previousLevelEntityId)")
		(var completedLevel:number = "previousLevelEntity.battlePassLevel.level" (event "previousLevelEntity.battlePassLevel.evChanged"))
		(var level:number = "battlePassCurrentLevel.countCompleted ? (completedLevel + battlePassCurrentLevel.countCompleted) : completedLevel")
	)

	(tf
		(name = 'battlepass_level')
		(class $TextDefaultBold22NM)
		(style (alpha = "TA"))
		(bind text "subst('IDS_SUBST_BATTLEPASS_CURRENT_LEVEL', [], { _level: level })")
	)

	(controller $Tooltip
		(renderer = 'SimpleStatusTooltip')
		(args
			_text = "_isBattlePassFree	? subst('IDS_SUBST_BATTLEPASS_FREE_TOOLTIP_TEXT', [], {_level: level})
										: subst('IDS_SUBST_BATTLEPASS_PAID_TOOLTIP_TEXT', [], {_level: level})"
		)
		(macro DEFAULT_TOOLTIP_BEHAVIOUR)
	)
)

(def element BattlePassTypes (_type:number)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(struct stageSize = STAGE_SIZE())
		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageSize.width"))

		(var isBattlePassPaidEnhanced:bool = "_type == SC.Common.BATTLEPASS_TYPES.PAID_ENHANCED")
		(var iconSize:number = "stageSize.width < 1400 ? 80 : 112")
		(var iconMargin:number = "(levelDimensions.size - iconSize) / 2")
	)
	(style (bind width "levelDimensions.size"))

	(element AnimatedProgressBar
		_startProgress = 0
		_progress = 100
		_size = "SIZE.MEDIUM"
		_isRounded = false
	)

	
	(block
		(style
			(align = "center")
			(width = 100%)
			(bind height "levelDimensions.size")
		)

		(block
			(style
				(position = "absolute")
				(width = 100%)
				(height = 1px)
				(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
				(alpha = 0.1)
			)
		)

		(block
			(class $BPCarouselVertRightBorder)
		)

		(block
			(class $BPCarouselVertLeftBorder)
		)

		(block
			(name = 'base_battlepass')
			(style
				(backgroundImage = 'url:../sse/battlepass/types/small/free.png')
				(backgroundSize = "cover")
				(bind width "iconSize")
				(bind height "iconSize")
				(bind marginTop "iconMargin")
			)
		)

		(controller $Tooltip
			(renderer='BattlePassTypeTooltip')
			(args
				_type = "SC.Common.BATTLEPASS_TYPES.FREE"
				_isReceived = true
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)
	)

	
	(block
		(style
			(align = "center")
			(width = 100%)
			(bind height "levelDimensions.size")
		)

		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundImage = 'url:../sse/battlepass/bg/level_special_border.png')
				(scale9grid = 2)
			)
		)

		(block
			(name = 'premium_battlepass')
			(style
				(backgroundSize = "cover")
				(bind width "iconSize")
				(bind height "iconSize")
				(bind marginTop "iconMargin")
				(bind backgroundImage "isBattlePassPaidEnhanced	? 'url:../sse/battlepass/types/small/paid_enhanced.png'
																: 'url:../sse/battlepass/types/small/paid_regular.png'")
			)
		)

		(controller $Tooltip
			(renderer='BattlePassTypeTooltip')
			(args
				_isReceived = "_type in SC.Common.BATTLEPASS_TYPES.PAID"
				_type = "isBattlePassPaidEnhanced	? SC.Common.BATTLEPASS_TYPES.PAID_ENHANCED
													: SC.Common.BATTLEPASS_TYPES.PAID_REGULAR"
			)
			(macro DEFAULT_TOOLTIP_BEHAVIOUR)
		)

		(block
			(class $FullsizeAbsolute)
			(element MOUSE_HANDLER_CONTAINER
				(macro STRUCT_MOUSE_DISPATCHER
					_mouseHandler = "mouseHandler"
				)

				(macro STRUCT_SOUND_HANDLER
					_mouseHandler = "mouseHandler"
					_soundSet = "'default_button'"
				)

				(macro STRUCT_CLICK_HANDLER
					_mouseHandler = "mouseHandler"
					_methods = "[
						{
							type: 'inputMapping.onRequest',
							name: 'purchaseBattlePass',
							args: {}
						}
					]"
				)
			)
		)
	)
)

(def element BattlePassTypeTooltip (_type:number = 0, _isReceived:bool = true)
	(scope
		(var isBattlePassFree:bool = "_type == SC.Common.BATTLEPASS_TYPES.FREE")
		(var isBattlePassPaid:bool = "isIn(_type, SC.Common.BATTLEPASS_TYPES.PAID)")
		(var postfixText:str = "isBattlePassPaid && _isReceived ? '_RECEIVED' : ''")
	)
	(bind name "isBattlePassFree ? 'bp_type_free' : 'bp_type_paid'")

	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)
	(style (width = 340px))

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = "'IDS_BATTLEPASS_TYPE_' + SC.Common.BATTLEPASS_TYPES.VALUE_TO_NAME[_type]"
		)
		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemStatusLine
			_text = "_isReceived	? 'IDS_BATTLEPASS_TYPE_TOOLTIP_STATUS_RECEIVED'
									: 'IDS_BATTLEPASS_TYPE_TOOLTIP_STATUS_LOCKED'"
			_unifiedStatus = "_isReceived	? SC.Ui_styles.UNIFIED_STATUS.CHECK
											: SC.Ui_styles.UNIFIED_STATUS.LOCK"
		)
		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemDescriptionText
			_descriptionText = "'IDS_BATTLEPASS_TYPE_TOOLTIP_DESCRIPTION_' + SC.Common.BATTLEPASS_TYPES.VALUE_TO_NAME[_type] + postfixText"
		)
		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemHorizontalDivider'
				(bind enabled "!isBattlePassFree")
			)
		)

		(block
			(style (width = 100%))
			(controller $Instance renderer='TooltipSystemStatusLine'
				(bind enabled "!isBattlePassFree")
				(args
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.MOUSE_LEFT"
					_text = 'IDS_BATTLEPASS_TYPE_TOOLTIP_MOUSE_INSTRUCTION'
				)
			)
		)
	)
)

(def element BattlePassProgressWithRewards ()
	(scope
		(event evScrollToIndex)
		(event evForceScrollToIndex)

		(struct stageSize = STAGE_SIZE())
		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageSize.width"))

		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())

		(struct activeTip = PULL_GUIDING_TIP(_type = "SC.Context_guiding_tip.TIP_TYPE.BATTLEPASS_MULTIPLE_REWARD"))
		(var targetRewardLevel:number = "getEntity(toNumber(activeTip.targetId)).battlePassReward.level ?: 0")

		(var mainProgressionCollection:dhCollection = "getCollectionByPath(CC.battlePassLevel, 'mainProgression')")
		(var mainProgressionLen:number = "mainProgressionCollection.length ?: 0")

		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var type:number =				"battlePassComponent.type"				(event "battlePassComponent.evChanged"))
		(var totalPoints:number =		"battlePassComponent.totalPoints"		(event "battlePassComponent.evChanged"))
		(var maxTotalPoints:number =	"battlePassComponent.maxTotalPoints"	(event "battlePassComponent.evChanged"))
		(var progress:number = "100% * totalPoints/maxTotalPoints")

		(var isBattlePassFree:bool = "type == SC.Common.BATTLEPASS_TYPES.FREE")

		
		(var currentLevelIndexToScrollTo:number = "max(1, min(mainProgressionLen, (targetRewardLevel ?: battlePassCurrentLevel.level) - BP_LEVELS_TO_SHOW_BEFORE_CURRENT_LEVEL)) - 1")

		(var progressBarWidth:number = "mainProgressionLen * levelDimensions.size + 1")
	)
	
	(dispatch
		evScrollToIndex
		args="{value: currentLevelIndexToScrollTo}"
		delay=0.1
		on='addedToStage'
		(bind trigger "totalPoints")
		(event "evForceScrollToIndex")
		(event "battlePassComponent.evStartRewardClaimAnimation")
	)
	(dispatch 'evCarouselBoundsChanged' dir="EventDirection.UP" args="{bounds: $globalLayoutBounds}" (event "$evLayoutBoundsChanged"))
	(bindcall externalCall 'sound.playSetSoundDirect' "['battlepass_progressbar', 'start']" (bind trigger "progress"))

	(class $Fullsize)
	(scrollArea
		(class $Fullsize)

		(macro DEFAULT_HORIZONTAL_SCROLL_PARAMS
			_singleStep = "levelDimensions.size"
			_wheelScrollSpeed = "0.7"
			_wheelScrollAcceleration = "0.8"
			_valueChangedEvent = "'evCarouselScrollValueChanged'"
		)

		(repeatController = 'battlePassLevelCard')
		(scrollPerItem = true)

		(content
			(style (bottom = 0px))

			(block
				(name = 'battlepass_levels')
				(style
					(marginLeft = -1px)
					(paddingLeft = 1px)
					(paddingRight = 1px)
					(bind width "progressBarWidth")
				)

				(element AnimatedProgressBar
					_startProgress = 0
					_progress = "progress < 100 ? progress : 100"
					_size = "SIZE.MEDIUM"
					_isRounded = false
				)
			)

			(hblock
				(style (bind height "levelDimensions.height"))

				(controller $DynamicRepeat renderer='BattlePassLevelCard' name='battlePassLevelCard'
					(bind count "mainProgressionLen")
					(args
						_battlePassLevelEntity = "mainProgressionCollection.getEntityAtIndex($index)"
						_isBattlePassFree = "isBattlePassFree"
					)
					(bind itemOffset "levelDimensions.size")
					(bind itemWidth "levelDimensions.size")
				)
			)
		)
		(bindcall scrollTo index="$event.value" (event "evScrollToIndex"))
	)
)

(def element BattlePassLevelCard (_battlePassLevelEntity:dhEntity, _isBattlePassFree:bool)
	(scope
		(event evTakeRewardClicked)
		(event evRewardFreeAnimationStart)
		(event evRewardPaidAnimationStart)

		(var battlePass:dhComponent = "getSingleComponent(CC.battlePass)")
		(var totalPoints:number = "battlePass.totalPoints" (event "battlePass.evChanged"))

		(var level:number = "_battlePassLevelEntity.battlePassLevel.level")
		(var isSpecialLevel:bool = "_battlePassLevelEntity.battlePassLevel.isSpecialLevel")
		(var pointsPerLevel:number = "_battlePassLevelEntity.battlePassLevel.pointsPerLevel")

		(var isTargetLevel:bool = "level == floor(totalPoints/pointsPerLevel)")

		(var freeRewardsCollection:dhCollection = "getCollectionByPath(CC.battlePassReward, 'byLevelAndRewardType.' + level + '_' + SC.Common.BATTLEPASS_REWARD_TYPES.FREE)")
		(var paidRewardsCollection:dhCollection = "getCollectionByPath(CC.battlePassReward, 'byLevelAndRewardType.' + level + '_' + SC.Common.BATTLEPASS_REWARD_TYPES.PAID)")
	)

	(dispatch
		evRewardFreeAnimationStart
		init=true
		(event "evTakeRewardClicked")
		(bind enabled "_isBattlePassFree && isTargetLevel")
	)

	(dispatch
		evRewardPaidAnimationStart
		init=true
		(event "evTakeRewardClicked")
		(bind enabled "!_isBattlePassFree && isTargetLevel")
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "cover")
			(bind backgroundImage "isSpecialLevel	?	_isBattlePassFree	? BP_SPINE_PATH + 'bp_level_special/type_free.skel'
																			: BP_SPINE_PATH + 'bp_level_special/type_paid.skel'
													:	''")
		)
		(controller $Spine
			(bind enabled "isSpecialLevel")
		)
	)

	(controller $FxInstance renderer='RewardPaidReceivedAnimation' lifetime="REWARD_PROGRESS_ANIMATION_TIME"
		(bindcall create (event "evRewardPaidAnimationStart"))
	)

	(controller $FxInstance renderer='RewardFreeReceivedAnimation' lifetime="REWARD_PROGRESS_ANIMATION_TIME"
		(bindcall create (event "evRewardFreeAnimationStart"))
	)

	
	(block
		(style
			(position = "absolute")
			(top = -34px)
			(width = 100%)
			(height = 24px)
			(align = "center|middle")
			(backgroundColor = "NO_COLOR")
		)
		(tf
			(bind class "isSpecialLevel ? '$TextDefaultBold18NM' : '$TextDefault18NM'")
			(style (bind alpha "isSpecialLevel ? TA : TS"))
			(bind text "level")
		)
	)

	
	(block
		(block
			(class $BPCarouselVertRightBorder)
		)
		(element BattlePassRewardRenderer
			_collection = "freeRewardsCollection"
			_isSpecialLevel = "isSpecialLevel"
		)
	)

	
	(block
		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundImage = 'url:../sse/battlepass/bg/level_border.png')
				(scale9grid = 2)
			)
		)

		(block
			(bind visible "_isBattlePassFree")
			(style
				(position = "absolute")
				(top = "SXS")
				(right = "SXS")
				(width = 19px)
				(height = 19px)
				(alpha = 0.45)
				(backgroundImage = 'url:../service_kit/unified_status_icons/icon_lock.png')
			)
		)

		(element BattlePassRewardRenderer
			_collection = "paidRewardsCollection"
			_isSpecialLevel = "isSpecialLevel"
		)
	)

	
	(block
		(style
			(position = "absolute")
			(top = "-BP_PROGRESSBAR_HEIGHT")
			(right = 0px)
			(width = 1px)
			(height = "BP_PROGRESSBAR_HEIGHT")
			(backgroundColor = 0xCC535555)
		)
	)
)

(def element BattlePassLevelFixed (_entityId:number, _isBattlePassFree:bool, _carouselWidth:number=0, _scrollPosition:number=0)
	(scope
		(macro HIGH_CONTRAST_DATA_SCOPE)

		(struct stageSize = STAGE_SIZE())
		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageSize.width"))

		(var battlePassLevelEntity:dhEntity = "getEntity(_entityId)")
		(struct battlePassLevel = PULL_BATTLEPASS_LEVEL_INFO(_entity="battlePassLevelEntity"))

		(var freeRewardsCollection:dhCollection = "getCollectionByPath(CC.battlePassReward, 'byLevelAndRewardType.' + battlePassLevel.level + '_' + SC.Common.BATTLEPASS_REWARD_TYPES.FREE)")
		(var paidRewardsCollection:dhCollection = "getCollectionByPath(CC.battlePassReward, 'byLevelAndRewardType.' + battlePassLevel.level + '_' + SC.Common.BATTLEPASS_REWARD_TYPES.PAID)")

		(var isPostProgression:bool = "toBool(battlePassLevelEntity.battlePassPostProgressionLevel)")

		(var mid:number = "(_carouselWidth + _scrollPosition) / levelDimensions.size")
		(var minLevelToObserve:number = "round(mid)")
	)

	(bindcall externalCall
		"'inputMapping.onAction'"
		"['BattlePassProxyUSS.updateObservableSpecialLevel', {minLevelToObserve: minLevelToObserve}]"
		init=true
		watch=false
		(bind trigger "minLevelToObserve")
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(backgroundSize = "cover")
			(bind backgroundImage "_isBattlePassFree	? BP_SPINE_PATH + 'bp_level_special/type_free.skel'
														: BP_SPINE_PATH + 'bp_level_special/type_paid.skel'")
		)
		(controller $Spine)
	)

	
	(block
		(macro SPECIAL_LEVEL_ELEMENTS_APPEAR_ANIMATION "battlePassLevel.level" 0)
		(class $MiddleAlignedAbsolutely)
		(style (top = "-BP_PROGRESSBAR_NUMBERS_OFFSET"))

		(hblock
			(tf
				(name = 'important_level')
				(bind class "isPostProgression ?  '$TextDefault18NM' : '$TextDefaultBold18NM'")
				(style (alpha = "TA"))
				(bind text "isPostProgression ? 'IDS_BATTLEPASS_STATUS_LEVEL_POST_PROGRESS' : battlePassLevel.level")
			)

			(block
				(bind visible "isPostProgression")
				(style
					(width = 19px)
					(height = 19px)
					(marginTop = -3px)
					(marginLeft = "XS")
					(backgroundImage = 'url:../service_kit/unified_status_icons/icon_info.png')
				)
			)

			(controller $Tooltip
				(renderer='PostprogressInfoTooltip')
				(bind enabled "isPostProgression")
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)
	)
	(block
		(style
			(position = "absolute")
			(right = 0px)
			(top = "-BP_PROGRESSBAR_HEIGHT")
			(bind width "levelDimensions.size")
		)

		(element AnimatedProgressBar
			_startProgress = "battlePassLevel.previousProgress"
			_progress = "battlePassLevel.progress"
			_size = "SIZE.MEDIUM"
			_isRounded = false
		)
	)

	
	(block
		(macro SPECIAL_LEVEL_ELEMENTS_APPEAR_ANIMATION "battlePassLevel.level" 0)

		(element BattlePassRewardRenderer
			_collection = "freeRewardsCollection"
			_isLevelFixed = true
		)

		(block
			(class $BPCarouselVertRightBorder)
		)

		(block
			(class $BPCarouselVertLeftBorder)
		)
	)

	
	(block
		(macro SPECIAL_LEVEL_ELEMENTS_APPEAR_ANIMATION "battlePassLevel.level" 0)

		(block
			(class $FullsizeAbsolute)
			(style
				(backgroundImage = 'url:../sse/battlepass/bg/level_special_border.png')
				(scale9grid = 2)
			)
		)

		(block
			(bind visible "_isBattlePassFree")
			(style
				(position = "absolute")
				(top = "SXS")
				(right = "SXS")
				(width = 19px)
				(height = 19px)
				(alpha = 0.45)
				(backgroundImage = 'url:../service_kit/unified_status_icons/icon_lock.png')
			)
		)

		(element BattlePassRewardRenderer
			_collection = "paidRewardsCollection"
			_isLevelFixed = true
		)
	)
)

(def element PostprogressInfoTooltip ()
	(macro TOOLTIP_SYSTEM_DEFAULT_BACKGROUND)
	(style(width = 340px))

	(element TOOLTIP_SYSTEM_DEFAULT_CONTAINER
		(element TooltipSystemHeaderSubheaderText
			_headerText = 'IDS_BATTLEPASS_STATUS_LEVEL_POST_PROGRESS'
		)
		(element TooltipSystemHorizontalDivider)

		(element TooltipSystemDescriptionText
			_descriptionText = 'IDS_BATTLEPASS_INFO_TOOLTIP_POSTPROGRESS'
		)
	)
)

(def element BattlePassRewardRenderer (	_collection:dhCollection, _isLevelFixed:bool = false)
	(scope
		(struct mouseHandler = MOUSE_HANDLER())

		(struct stageSize = STAGE_SIZE())
		(struct levelDimensions = BP_LEVEL_SIZE(_stageWidth = "stageSize.width"))
		(struct animation = PULL_ANIMATION_SIZE(_scale = "levelDimensions.scale.value"))

		(var battlePassComponent:dhComponent = "getSingleComponent(CC.battlePass)")
		(var observableReward:number = "battlePassComponent.observableReward ?: 0" (event "battlePassComponent.evObservableRewardChanged"))
		(var isFreeBpType:bool = "battlePassComponent.type == SC.Common.BATTLEPASS_TYPES.FREE" (event "battlePassComponent.evChanged"))

		(struct rewardsInfo = PULL_BATTLEPASS_MULTIPLE_REWARD_STATE(_collection = "_collection"))
		(struct rewardObservable = PULL_BATTLEPASS_REWARD_INFO(_entityId = "getEntity(observableReward).id"))

		(var isMultipleReward:bool = "_collection.length > 1")
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(macro STRUCT_CLICK_HANDLER
		_mouseHandler = "mouseHandler"
		_methods = "[
			{
				type: isMultipleReward ? '' : 'inputMapping.onAction',
				name: 'BattlePassProxyUSS.updateObservableReward',
				args: { battlePassRewardEntityId: _collection.getEntityAtIndex(0).id }
			}
		]"
	)

	(style
		(align = "center|middle")
		(backgroundColor = "NO_COLOR")
		(bind width "levelDimensions.size")
		(bind height "levelDimensions.size")
	)
	(block
		(bind visible "rewardsInfo.isAvailable")
		(style
			(hitTest = false)
			(position = "absolute")
			(backgroundSize = "cover")
			(bind top "animation.offset")
			(bind left "animation.offset")
			(bind width "animation.size")
			(bind height "animation.size")
			(bind backgroundImage "rewardsInfo.isAvailable ? 'url:../animations/spine/rewards/reward_states/available.skel' : ''")
		)
		(bind colorTransform "isFreeBpType ? CT_FREE_REWARD_AVAILABLE : CT_PAID_REWARD_AVAILABLE")
		(controller $Spine
			(bind enabled "rewardsInfo.isAvailable")
		)
	)

	(block
		(class $Fullsize)
		(controller $Instance renderer='BattlePassRewardItem'
			(bind enabled "!isMultipleReward")
			(args
				_battlePassRewardEntityId = "_collection.getEntityAtIndex(0).id"
				_observableReward = "observableReward"
				_isLevelFixed = "_isLevelFixed"
			)
		)

		(controller $Instance renderer = 'MultipleReward'
			(bind enabled "isMultipleReward")
			(args
				_collection = "_collection"
				_observableReward = "observableReward"
				_isLevelFixed = "_isLevelFixed"
				_isFreeBpType = "isFreeBpType"
			)
		)
	)
)

(def element RewardFreeReceivedAnimation ()
	(scope
		(var stageComponent:dhComponent = "getSingleComponent(CC.stage)")
		(var stageWidth:number = "stageComponent.width" (event "stageComponent.evStageSizeChanged"))

		(var animationHeight:number =	"stageWidth < 1400 ? BP_REWARD_ANIMATION_HEIGHT_MIN		: BP_REWARD_ANIMATION_HEIGHT_MAX")
		(var animationWidth:number =	"stageWidth < 1400 ? BP_FREE_REWARD_ANIMATION_WIDTH_MIN	: BP_FREE_REWARD_ANIMATION_WIDTH_MAX")
		(var topOffset:number =		"stageWidth < 1400 ? -300 : -375")
		(var leftOffset:number =	"stageWidth < 1400 ? -360 : -450")
	)
	(bindcall externalCall 'sound.playSetSoundDirect' "['battlepass_reward_new', 'start']" init=false watch=false on='addedToStage')
	
	(style
		(hitTest = false)
		(position = "absolute")
		(backgroundSize = "cover")
		(backgroundImage = "BP_SPINE_PATH + 'progress/progress_free.skel'")
		(bind top "topOffset")
		(bind left "leftOffset")
		(bind width "animationWidth")
		(bind height "animationHeight")
	)
	(controller $Spine)
)

(def element RewardPaidReceivedAnimation ()
	(scope
		(var stageComponent:dhComponent = "getSingleComponent(CC.stage)")
		(var stageWidth:number = "stageComponent.width" (event "stageComponent.evStageSizeChanged"))

		(var animationWidth:number =	"stageWidth < 1400 ? BP_PAID_REWARD_ANIMATION_WIDTH_MIN	: BP_PAID_REWARD_ANIMATION_WIDTH_MAX")
		(var animationHeight:number =	"stageWidth < 1400 ? BP_REWARD_ANIMATION_HEIGHT_MIN		: BP_REWARD_ANIMATION_HEIGHT_MAX")
		(var bottomOffset:number =	"stageWidth < 1400 ? -180 : -225")
		(var leftOffset:number =	"stageWidth < 1400 ? -708 : -885")
	)
	(bindcall externalCall 'sound.playSetSoundDirect' "['battlepass_reward_new', 'start']" on='addedToStage')

	(style
		(hitTest = false)
		(position = "absolute")
		(backgroundSize = "cover")
		(backgroundImage = "BP_SPINE_PATH + 'progress/progress_paid.skel'")
		(bind bottom "bottomOffset")
		(bind left "leftOffset")
		(bind width "animationWidth")
		(bind height "animationHeight")
	)
	(controller $Spine)
)

(def element BattlePassRewardInfo (_battlePassRewardEntityId:number)
	(scope
		(var battlePass:dhComponent = "getSingleComponent(CC.battlePass)")

		(struct battlePassType = PULL_BATTLEPASS_TYPE(_component="battlePass"))
		(struct battlePassCurrentLevel = PULL_BATTLEPASS_CURRENT_LEVEL())

		(struct battlePassReward = PULL_BATTLEPASS_REWARD_INFO(_entityId = "_battlePassRewardEntityId"))
		(struct battlePassRewardState = PULL_BATTLEPASS_REWARD_STATE(_rewardState = "battlePassReward.rewardState"))

		(var battlePassLevelEntity:dhEntity = "getPrimaryEntity(CC.battlePassLevel, battlePassReward.level)")
		(struct battlePassLevel = PULL_BATTLEPASS_LEVEL_INFO(_entity = "battlePassLevelEntity"))

		(var rewardComponent:dhComponent = "getEntity(battlePassReward.rewardId).rewardComponent")

		(var isMultipleReward:bool = "getCollectionByPath(CC.battlePassReward, 'byLevelAndRewardType.' + battlePassLevel.level + '_' + battlePassReward.type).length > 1")

		(var isLevelCompleted:bool = "battlePassLevel.currentPoints == battlePassLevel.pointsPerLevel")
		(var isLevelInProgress:bool = "battlePassCurrentLevel.level == battlePassReward.level")
		(var isLevelLocked:bool = "battlePassType.isFree	? (battlePassLevel.level > battlePassCurrentLevel.level && !battlePassReward.isPaidTrack)
															: battlePassLevel.level > battlePassCurrentLevel.level")
		(var isPaidRewardUnavailable:bool = "battlePassType.isFree && battlePassRewardState.isUnavailable")
		(var isStatusBlockVisible:bool = "	(battlePassReward.isPaidTrack && isPaidRewardUnavailable) ||
											battlePassRewardState.isReceived || isLevelLocked")
		(var isPointsCounterBlockVisible:bool = "!isLevelCompleted && isLevelInProgress && !isStatusBlockVisible")

		(var statusBlockText:str = "	battlePassRewardState.isReceived	? 'IDS_BATTLEPASS_STATUS_REWARD_TAKEN' :
										isLevelLocked						? 'IDS_BATTLEPASS_LEVEL_STATUS_LOCKED'
																			: 'IDS_BATTLEPASS_CARD_STATUS_LOCK'")

		(var warningStatus:number = "	battlePassType.type != battlePassReward.type &&
										battlePassType.isFree								? BP_CHOICE_BUTTON_WARNING.LOCKED_BY_TYPE_AND_LEVEL :
										!isLevelCompleted									? BP_CHOICE_BUTTON_WARNING.LOCKED_BY_LEVEL
																							: BP_CHOICE_BUTTON_WARNING.LOCKED_BY_BONUSES")
	)
	(bind name "'BattlePassRewardRenderer' + battlePassReward.rewardId")

	(block
		(bind visible "isMultipleReward && !battlePassRewardState.isReceived && !battlePassType.isPaidEnhanced")
		(style (marginBottom = "{720:M, 1080:L}"))

		(tf
			(class $TextDefaultBold36NM)
			(style
				(marginBottom = "{720:SXS, 1080:MS}")
				(alpha = "TA")
			)
			(text = 'IDS_BATTLEPASS_REWARDS_CHOICE')
		)

		(block
			(controller $Instance renderer='DefaultButton'
				(bind enabled "isMultipleReward")
				(args
					_width = 150px
					_name = 'choose_multiple_reward_btn'
					_label = 'IDS_BATTLEPASS_REWARDS_CLAIM_BUTTON'
					_enabled = "battlePassRewardState.isAvailable"
					_focusIndex = 0
					_methods = "[
						{
							type: 'inputMapping.onRequest',
							name: 'rewardMultipleClaimConfirm',
							args: { _battlePassRewardEntityId: _battlePassRewardEntityId }
						}
					]"
				)
			)
			(controller $Tooltip
				(bind enabled "!battlePassRewardState.isAvailable")
				(renderer='SimpleStatusTooltip')
				(args
					_text = "'IDS_BATTLEPASS_REWARDS_CHOICE_WARNING_' + warningStatus"
					_unifiedStatus = "SC.Ui_styles.UNIFIED_STATUS.NEGATIVE"
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)
	)

	
	(block
		(macro DETAILED_CARD_ELEMENTS_APPEAR_ANIMATION_BY_ID "battlePassReward.rewardId" 0)
		(style (bind marginBottom "isStatusBlockVisible || isPointsCounterBlockVisible ? MS : 0"))

		(element RewardTitle
			_rewardEntityId = "battlePassReward.rewardId"
		)

		(hblock
			(style (bind marginTop "rewardComponent.amount ? M : 0"))
			(block
				(controller $Instance renderer='BattlePassRewardCount'
					(bind enabled "rewardComponent.amount")
					(args
						_rewardComponent = "rewardComponent"
					)
				)
			)

			(block
				(bind visible "rewardComponent.params.isLinkAvailable")
				(style
					(height = 20px)
					(marginTop = "-XS")
					(paddingLeft = "S")
					(paddingRight = "S")
				)
				(element VerticalDivider)
			)

			(block
				(controller $Instance renderer='LinkWithIcon'
					(bind enabled "rewardComponent.params.isLinkAvailable")
					(args
						_label = 'IDS_LOOTBOX_REWARDS_PROBABILITIES'
						_methods = "[
							{
								type: 'inputMapping.onAction',
								name: 'navigateTo',
								args: {
									route: SC.Ui_windows.ROUTE.OVERLAY_BROWSER,
									data: {
										url: SC.Ui_windows.GUI_URL.LOOTBOX_CONTENTS,
										lootboxId: rewardComponent.id
									}
								}
							}
						]"
					)
				)
			)
		)
	)


	
	(block
		(macro DETAILED_CARD_ELEMENTS_APPEAR_ANIMATION_BY_ID "battlePassReward.rewardId" 1)
		(controller $Instance renderer='StatusLine'
			(bind enabled "isStatusBlockVisible")
			(args
				_textClass = '$TextDefault20NM'
				_text = "statusBlockText"
				_unifiedStatus = "battlePassRewardState.isReceived	? SC.Ui_styles.UNIFIED_STATUS.CHECK
																	: SC.Ui_styles.UNIFIED_STATUS.LOCK"
			)
		)
	)

	
	(hblock
		(macro DETAILED_CARD_ELEMENTS_APPEAR_ANIMATION_BY_ID "battlePassReward.rewardId" 2)
		(bind visible "isPointsCounterBlockVisible")

		(tf
			(class $TextDefault20NM)
			(style
				(marginRight = "S")
				(alpha = "TC")
			)
			(text = 'IDS_BATTLEPASS_CARD_STATUS_POINTS')
		)

		(hblock
			(style (marginTop = "XXS"))

			(controller $Instance renderer='PriceTag'
				(bind enabled "isPointsCounterBlockVisible")
				(args
					_size = "SIZE.MEDIUM"
					_priceInfo = "{
						finalPrice: battlePassLevel.pointsPerLevel - battlePassLevel.currentPoints,
						currency: SC.Common.CURRENCIES.BP_POINTS
					}"
				)
			)

			(controller $Tooltip
				(renderer='SimpleStatusTooltip')
				(args
					_text = 'IDS_BATTLEPASS_STATUS_LEVEL_POINTS'
				)
				(macro DEFAULT_TOOLTIP_BEHAVIOUR)
			)
		)
	)
)

(def element BattlePassTimer ()
	(scope
		(var battlePassEntity:dhEntity = "getSingleEntity(CC.battlePass)")
		(var finishTime:number = "battlePassEntity.battlePass.finishTime ?: 0" (event "battlePassEntity.battlePass.evChanged"))

		(struct serverTime = SERVER_TIME())
		(struct formattedFinishTime = COUNTDOWN(_time = "finishTime" _serverTime = "serverTime.value" _format = "'HIGHEST,WITH_DAYS'"))

		(var unifiedStatus:str = "finishTime - serverTime.value < DAY_IN_SEC	? SC.Ui_styles.UNIFIED_STATUS.DATE_ATTENTION
																				: SC.Ui_styles.UNIFIED_STATUS.DATE")
	)
	(name = 'battlepass_timer')

	(element StatusLine
		_text = "subst('IDS_SUBST_BATTLEPASS_STATUS_TIME', [], { timeLeft: formattedFinishTime.value })"
		_unifiedStatus  = "unifiedStatus"
	)
)

(def element MultipleReward (	_collection:dhCollection = null,
								_isLevelFixed:bool = false,
								_isFreeBpType:bool = false,
								_observableReward:number = 0)
	(scope
		(event evShowIconCheck)
		(event evSelectedStateDisabled)

		(struct stageSize = STAGE_SIZE())
		(struct scale = PULL_BP_ASSET_SCALE(_stageWidth = "stageSize.width"))

		(struct mouseHandler = MOUSE_HANDLER())
		(struct mouseHandlerLeft = MOUSE_HANDLER())
		(struct mouseHandlerRight = MOUSE_HANDLER())

		(struct multipleRewardState = PULL_BATTLEPASS_MULTIPLE_REWARD_STATE(_collection="_collection"))
		(var isFirstClaimed:bool = "multipleRewardState.firstRewardState == SC.Common.BATTLEPASS_REWARD_STATE.CLAIMED")
		(var isSecondClaimed:bool = "multipleRewardState.secondRewardState == SC.Common.BATTLEPASS_REWARD_STATE.CLAIMED")

		(var isFirstSelected:bool = "_collection[0].id == _observableReward")
		(var isSecondSelected:bool = "_collection[1].id == _observableReward")

		(struct activeTip = PULL_ACTIVE_GUIDING_TIP())
		(struct checkedTipId = SAFE_CHECK_ACTIVE_TIP_ID(
				_tipId = "activeTip.tipId"
				_validValues = "[ SC.Context_guiding_tip.TIP_TYPE.BATTLEPASS_MULTIPLE_REWARD ]"
			)
		)
	)
	(dispatch evSelectedStateDisabled (bind trigger "!isFirstSelected && !isSecondSelected"))

	(class $Fullsize)

	(dispatch
		evShowIconCheck
		(bind enabled "multipleRewardState.areAllClaimed")
		(event "multipleRewardState.firstRewardComponent.evRewardStateChanged")
		(event "multipleRewardState.secondRewardComponent.evRewardStateChanged")
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(block
		(class $Fullsize)

		(macro STRUCT_MOUSE_DISPATCHER
			_mouseHandler = "mouseHandlerLeft"
		)

		(bindcall externalCall
			'inputMapping.onAction'
			"['BattlePassProxyUSS.updateObservableReward', { battlePassRewardEntityId: _collection[0].id }]"
			init=false
			watch=false
			on='leftClick'
		)

		(element BattlePassMultipleRewardItem
			_battlePassRewardEntityId = "_collection[0].id"
			_observableReward = "_observableReward"
			_isLevelFixed = "_isLevelFixed"
			_areAllClaimed = "multipleRewardState.areAllClaimed"
		)

		(block
			(style
				(position = "absolute")
				(rotation = 30)
				(backgroundColor = "NO_COLOR")
				(bind top "-80px * scale.value")
				(bind left "-8px * scale.value")
				(bind width "150px * scale.value")
				(bind height "230px * scale.value")
			)
			(isMask = true)

			(macro BATTLEPASS_MULTIPLE_REWARD_ANIM
				_isFirstClaimed = "isFirstClaimed"
				_isSecondClaimed = "isSecondClaimed"
				_isFirstSelected = "isFirstSelected"
				_isSecondSelected = "isSecondSelected"
				_rightTrigger = "mouseHandlerRight.rollOver"
				_leftTrigger = "mouseHandlerLeft.rollOver"
				_rollOver = "mouseHandler.rollOver"
				_scale = "scale.value"
			)
		)
	)

	(block
		(class $FullsizeAbsolute)

		(macro STRUCT_MOUSE_DISPATCHER
			_mouseHandler = "mouseHandlerRight"
		)

		(bindcall externalCall
			'inputMapping.onAction'
			"['BattlePassProxyUSS.updateObservableReward', { battlePassRewardEntityId: _collection[1].id }]"
			init=false
			watch=false
			on='leftClick'
		)

		(element BattlePassMultipleRewardItem
			_battlePassRewardEntityId = "_collection[1].id"
			_observableReward = "_observableReward"
			_isLevelFixed = "_isLevelFixed"
			_areAllClaimed = "multipleRewardState.areAllClaimed"
		)

		(block
			(style
				(position = "absolute")
				(rotation = 30)
				(backgroundColor = "NO_COLOR")
				(bind top "-40px * scale.value")
				(bind right "-142px * scale.value")
				(bind width "150px * scale.value")
				(bind height "230px * scale.value")
			)
			(isMask = true)

			(macro BATTLEPASS_MULTIPLE_REWARD_ANIM
				_isFirstClaimed = "isFirstClaimed"
				_isSecondClaimed = "isSecondClaimed"
				_isFirstSelected = "isFirstSelected"
				_isSecondSelected = "isSecondSelected"
				_rightTrigger = "mouseHandlerRight.rollOver"
				_leftTrigger = "mouseHandlerLeft.rollOver"
				_rollOver = "mouseHandler.rollOver"
				_scale = "scale.value"
			)
		)
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(backgroundSize = "contain")
			(bind backgroundImage "_isFreeBpType	? 'url:../sse/battlepass/multiple_reward_divider_blue.png'
													: 'url:../sse/battlepass/multiple_reward_divider_orange.png'")
			(bind alpha "multipleRewardState.areAllClaimed ? 0.5 : 1")
			(filters
				(colorMatrix
					(bind matrix "multipleRewardState.areAllClaimed ? [ 0, -50, 0, -15 ] : [0, 0, 0, 0]")
				)
			)
		)

		(macro BATTLEPASS_MULTIPLE_REWARD_ANIM
			_isFirstClaimed = "isFirstClaimed"
			_isSecondClaimed = "isSecondClaimed"
			_isFirstSelected = "isFirstSelected"
			_isSecondSelected = "isSecondSelected"
			_rightTrigger = "mouseHandlerRight.rollOver"
			_leftTrigger = "mouseHandlerLeft.rollOver"
			_rollOver = "mouseHandler.rollOver"
			_scale = "scale.value"
		)
	)

	(block
		(bind visible "multipleRewardState.areAllClaimed")

		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(align = "center|middle")
		)

		(block
			(style
				(width = 48px)
				(height = 48px)
				(pivotX = 50%)
				(pivotY = 50%)
				(backgroundImage = 'url:../reward_categories/icon_check.png')
			)

			(controller $Animation
				(bindcall play
					duration = 0.5
					from = "{ visualScaleX: 2, visualScaleY: 2, alpha: 0 }"
					to =  "{ visualScaleX: 1, visualScaleY: 1, alpha: 1 }"
					(event "evShowIconCheck")
				)
			)
		)
	)

	(controller $Instance renderer='GuidingTipHub'
		(bind enabled "checkedTipId.value && activeTip.targetId == _collection[1].id")
		(args
			_tipId =			"checkedTipId.value"
			_tipPositioning =	"TIP_POSITION_TOP"
			_offsetY =			"MS"
			_pointerOffset =	"MS"
			_modalWindowName =	"SC.Ui_windows.MODAL.BATTLE_PASS_MAIN"
		)
	)
)

(def element BattlePassMultipleRewardItem (	_battlePassRewardEntityId:number = 0,
											_observableReward:number = 0,
											_isLevelFixed:bool = false,
											_areAllClaimed:bool = false)
	(scope
		(var isSelected:bool = "_battlePassRewardEntityId == getEntity(_observableReward).id")
	)
	(class $Fullsize)

	(element BattlePassRewardItem
		_isMultipleReward = true
		_isAmountVisible = false
		_battlePassRewardEntityId = "_battlePassRewardEntityId"
		_isLevelFixed = "_isLevelFixed"
		_areAllClaimed = "_areAllClaimed"
		_isSelected = "isSelected"
		_soundSet = "'button_battlepass_multi_reward'"
		_observableReward = "_observableReward"
	)
)

(def element BattlePassRewardItem (	_battlePassRewardEntityId:number = 0,
									_observableReward:number = 0,
									_isAmountVisible:bool = true,
									_isLevelFixed:bool = false,
									_areAllClaimed:bool = false,
									_soundSet:str = 'button_battlepass_reward')
	(scope
		(event evShowIconCheck)
		(struct mouseHandler = MOUSE_HANDLER())

		(struct battlePassReward = PULL_BATTLEPASS_REWARD_INFO(_entityId = "_battlePassRewardEntityId"))
		(struct battlePassRewardState = PULL_BATTLEPASS_REWARD_STATE(_rewardState = "battlePassReward.rewardState"))

		(var rewardComponent:dhComponent = "getEntity(battlePassReward.rewardId).rewardComponent")
		(var reward:dict = "{	id:			rewardComponent.id,
								amount:		rewardComponent.amount,
								name:		rewardComponent.name,
								type:		rewardComponent.type,
								subtype:	rewardComponent.subtype,
								params:		rewardComponent.params,
								isPRMP:		rewardComponent.isPRMP }")

		(var isSelected:bool = "_battlePassRewardEntityId == _observableReward")
		(var isIconCheckEnabled:bool = "battlePassRewardState.isReceived && !_areAllClaimed")
		(var state:number = "	isSelected				? SC.Ui_styles.BUTTON_STATE.SELECTED :
								mouseHandler.mouseDown	? SC.Ui_styles.BUTTON_STATE.DOWN :
								mouseHandler.rollOver	? SC.Ui_styles.BUTTON_STATE.OVER :
								isIconCheckEnabled		? SC.Ui_styles.BUTTON_STATE.DISABLED
														: SC.Ui_styles.BUTTON_STATE.UP")
		(var cellAlpha:number = "CELL_ALPHA[state]")

		(struct stageSize = STAGE_SIZE())
		(struct scale = PULL_BP_ASSET_SCALE(_stageWidth = "stageSize.width"))
		(struct animation = PULL_ANIMATION_SIZE(_scale = "scale.value"))
	)
	(dispatch evShowIconCheck (bind enabled "isIconCheckEnabled") (event "battlePassReward.component.evRewardStateChanged"))
	(class $Fullsize)
	(style
		(align = "center|middle")
		(backgroundColor = "NO_COLOR")
	)

	(macro STRUCT_MOUSE_DISPATCHER
		_mouseHandler = "mouseHandler"
	)

	(macro STRUCT_SOUND_HANDLER
		_mouseHandler = "mouseHandler"
		_soundSet = "_soundSet"
	)

	(block
		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(backgroundColor = "SC.Ui_styles.SERVICE_COLORS.WHITE")
			(borderRadius = "XS")
			(alpha = "cellAlpha")
		)
		(macro DEFAULT_CONTROL_STATE_ANIMATION_ALPHA
			_trigger = "state"
			_alpha = "cellAlpha"
		)
	)

	(block
		(bind visible "isSelected")
		(style
			(hitTest = false)
			(position = "absolute")
			(backgroundSize = "cover")
			(bind top "animation.offset")
			(bind left "animation.offset")
			(bind width "animation.size")
			(bind height "animation.size")
			(bind backgroundImage "isSelected ? BP_SPINE_PATH + 'reward_states/selected.skel' : ''")
		)
		(controller $Spine
			(bind enabled "isSelected")
		)
	)

	(element RewardItem
		_isBattlePassSmallIconView = true
		_isAmountVisible = "_isAmountVisible"
		_reward = "reward"
		_isUnavailable = "battlePassRewardState.isReceived"
		_isReceived = "battlePassRewardState.isReceived && _isLevelFixed && !_areAllClaimed"
	)

	(block
		(bind visible "isIconCheckEnabled")

		(class $FullsizeAbsolute)
		(style
			(hitTest = false)
			(align = "center|middle")
		)

		(block
			(style
				(width = 48px)
				(height = 48px)
				(pivotX = 50%)
				(pivotY = 50%)
				(backgroundImage = 'url:../reward_categories/icon_check.png')
			)

			(controller $Animation
				(bindcall play
					duration = 0.5
					from = "{ visualScaleX: 2, visualScaleY: 2, alpha: 0 }"
					to =  "{ visualScaleX: 1, visualScaleY: 1, alpha: 1 }"
					(event "evShowIconCheck")
				)
			)
		)
	)
)

(def element BattlePassRewardCount (_rewardComponent:dhComponent)
	(scope
		(struct rewardSubtype = CORRECT_REWARD_RESOURCE_SUBNAME(_subtype = "_rewardComponent.subtype"))
		(var isPrem:bool = "rewardSubtype.value == 'mk_premium'")
		(var hasPriceTag:bool = "rewardSubtype.value in REWARD_RESOURCE_ELEMENT && !isPrem")
	)
	(style (flow = "horizontal"))

	(tf
		(class $TextDefaultNM)
		(style
			(alpha = "TA")
			(marginRight = "S")
		)
		(text = 'IDS_COUNT')
	)
	(block
		(controller $Instance renderer='PriceTag'
			(bind enabled "hasPriceTag")
			(args
				_priceInfo = "{ finalPrice: _rewardComponent.amount, currency: _rewardComponent.subtype }"
			)
		)
		(tf
			(bind visible "!hasPriceTag")
			(class $TextDefaultBoldNM)
			(style (alpha = "TA"))
			(bind text "formatSeparator(isPrem ? _rewardComponent.params.text : _rewardComponent.amount)")
		)
	)
)
